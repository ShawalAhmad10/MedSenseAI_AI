# Copy these settings into backend/.env. Use Sandbox credentials from the same app.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_DAILY_PLAN_ID=
PAYPAL_WEEKLY_PLAN_ID=
PAYPAL_MONTHLY_PLAN_ID=
# Optional legacy alias for the monthly plan: PAYPAL_PLAN_ID
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Public HTTPS backend origin or full /api/paypal/webhook URL.
PAYPAL_PUBLIC_URL=
# Legacy alias PAYPAL_PUBLIC_BASE_URL is also supported.
