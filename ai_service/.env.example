# MedSenseAI AI Service - PUBLIC CONFIGURATION EXAMPLE
# Copy to .env and insert private credentials locally.
# Never commit the real .env file.

MEDSENSE_ENVIRONMENT=development
MEDSENSE_LOG_LEVEL=INFO
MEDSENSE_API_PREFIX=/api/v1

MEDSENSE_DDI_MODEL_DIR=artifacts/ddi/model
MEDSENSE_DDI_KNOWN_INTERACTION_SOURCE=external/db_drug_interactions.csv

# Final development DB:
# PostgreSQL 18
# Port: 5433
# Database: medsenseai_pharm
# Schema: medsense_app
MEDSENSE_DATABASE_URL=postgresql+psycopg://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5433/medsenseai_pharm?options=-csearch_path%3Dmedsense_app
